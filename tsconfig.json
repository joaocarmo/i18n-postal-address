{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "strict": true,
    "target": "esnext",
    "types": ["node", "vitest/globals"]
  },
  "include": ["lib/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "vitest*.ts"],
  "exclude": ["node_modules", "dist/**/*", "test/functional"]
}
