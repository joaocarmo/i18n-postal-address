{
  "name": "i18n-postal-address",
  "version": "0.0.0-development",
  "description": "A JavaScript library to produce international postal addresses formatted by region for node and the web",
  "homepage": "https://joaocarmo.com/i18n-postal-address-playground",
  "author": "João Carmo",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./formats": {
      "types": "./dist/formats/index.d.ts",
      "import": "./dist/formats/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm build:lib",
    "build:lib": "tsc -p tsconfig.build.json",
    "clean": "node -e \"for (const path of ['dist', 'node_modules/.cache']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepare": "husky",
    "pretty:fix": "prettier --write .",
    "pretty": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "test:functional": "tsc -p test/functional && vitest run --config vitest.functional.config.ts",
    "test:smoke": "node test/smoke/node.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test": "vitest run",
    "type-check:watch": "pnpm type-check -- --watch",
    "type-check": "tsc --noEmit",
    "formats:fetch": "tsx scripts/fetch-google-formats.ts",
    "formats:transform": "tsx scripts/transform-google-formats.ts",
    "formats:diff": "tsx scripts/diff-formats.ts",
    "formats:update": "tsx scripts/fetch-google-formats.ts && tsx scripts/transform-google-formats.ts && tsx scripts/diff-formats.ts"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaocarmo/i18n-postal-address.git"
  },
  "bugs": {
    "url": "https://github.com/joaocarmo/i18n-postal-address/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "address",
    "formatter",
    "i18n",
    "node",
    "postal",
    "web"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
